# Copy to .env for local development. Never commit .env.
DEBUG=1
DATABASE_URL=postgres://postgres:YOUR-PASSWORD@localhost:5432/shelter

# Only needed when DEBUG is off (the test site sets these in Render).
# SECRET_KEY=
# ALLOWED_HOSTS=
# DATABASE_SSL_REQUIRE=1

# Shows the style guide and (from Phase 1) demo data.
# DEMO_MODE=1

# Email: without EMAIL_HOST_USER, emails are printed to the console instead of sent.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Shown in the footer and on error pages (placeholders until the shelter provides them).
# SHELTER_NAME=Humane Society of Madison County
# SHELTER_PHONE=
# SHELTER_EMAIL=
